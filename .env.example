# Supabase PostgreSQL (replace prefix postgresql:// with postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>

# Upstash Redis (protocol URL, NOT the REST URL)
UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>:6379

# Upstash Redis REST (optional, for HTTP-based access)
UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-rest-token>

# Google Gemini API
GOOGLE_API_KEY=<your-gemini-api-key>
